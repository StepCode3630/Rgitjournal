{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RGitJournal",
  "version": "1.0.1",
  "identifier": "com.gitjournal.desktop",
  "build": {
    "frontendDist": "../dist/desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "enableGTKAppId": true,
    "windows": [
      {
        "label": "main",
        "title": "RGitJournal — Journal de travail",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/512x512.png",
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "../src/assets/icon.ico",
      "icons/RGitJIcon.icns"
    ],
    "fileAssociations": [
      {
        "ext": ["gitj"],
        "name": "RGitJournal Project",
        "role": "Editor"
      }
    ],
    "resources": {
      "../LICENSE": "LICENSE",
      "fonts/OFL.txt": "licenses/NotoSans-OFL.txt"
    },
    "linux": {
      "deb": {
        "depends": ["git"],
        "desktopTemplate": "linux/GitJournal.desktop",
        "files": {
          "/usr/share/applications/com.gitjournal.desktop.desktop": "linux/com.gitjournal.desktop.desktop",
          "/usr/share/mime/packages/gitjournal.xml": "linux/gitjournal.xml"
        }
      },
      "rpm": {
        "depends": ["git"],
        "desktopTemplate": "linux/GitJournal.desktop",
        "files": {
          "/usr/share/applications/com.gitjournal.desktop.desktop": "linux/com.gitjournal.desktop.desktop",
          "/usr/share/mime/packages/gitjournal.xml": "linux/gitjournal.xml"
        }
      }
    }
  }
}
