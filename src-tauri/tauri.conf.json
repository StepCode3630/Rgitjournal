{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitJournal",
  "version": "4.1.1",
  "identifier": "com.gitjournal.desktop",
  "build": {
    "frontendDist": "../dist/desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "GitJournal — Journal de travail",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../src/assets/icon.png",
      "../src/assets/icon.ico",
      "../src/assets/icon.icns"
    ],
    "fileAssociations": [
      {
        "ext": ["gitj"],
        "name": "GitJournal Project",
        "role": "Editor"
      }
    ]
  }
}
